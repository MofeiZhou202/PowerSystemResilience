{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HACDCPF_DEPENDENCY_PROFILE": "portable",
        "HACDCPF_BUILD_TESTS": "ON",
        "HACDCPF_ENABLE_NATIVE_ARCH": "OFF",
        "HACDCPF_ENABLE_WERROR": "OFF",
        "HACDCPF_USE_SUITESPARSE": "ON",
        "HACDCPF_USE_GUROBI": "ON",
        "HACDCPF_USE_PAPILO": "ON",
        "MIPSOLVERS_SOURCE_DIR": "${sourceDir}/../MIPSolvers"
      }
    },
    {
      "name": "macos-release",
      "displayName": "macOS Release",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "HACDCPF_ENABLE_IPOPT": "ON"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "HACDCPF_ENABLE_IPOPT": "OFF"
      }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC Release",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "cacheVariables": {
        "HACDCPF_ENABLE_IPOPT": "OFF",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
      },
      "environment": {
        "HACDCPF_OPF_LINEAR_SOLVER": "auto"
      }
    },
    {
      "name": "windows-vcpkg-release",
      "displayName": "Windows MSVC Release with vcpkg",
      "inherits": "windows-msvc-release",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "HACDCPF_SUITESPARSE_ROOT": "$env{VCPKG_ROOT}/installed/x64-windows"
      },
      "environment": {
        "SUITESPARSE_ROOT": "$env{VCPKG_ROOT}/installed/x64-windows"
      }
    },
    {
      "name": "full-dev",
      "displayName": "Full Developer Build",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "HACDCPF_DEPENDENCY_PROFILE": "full"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-release",
      "configurePreset": "macos-release",
      "jobs": 8
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "jobs": 8
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release",
      "configuration": "Release",
      "jobs": 8
    },
    {
      "name": "windows-vcpkg-release",
      "configurePreset": "windows-vcpkg-release",
      "configuration": "Release",
      "jobs": 8
    },
    {
      "name": "full-dev",
      "configurePreset": "full-dev",
      "jobs": 8
    }
  ],
  "testPresets": [
    {
      "name": "macos-release",
      "configurePreset": "macos-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-vcpkg-release",
      "configurePreset": "windows-vcpkg-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
