{
  "schema_version": "1.0",
  "screening_id": "shaanxi_nex_gddp_cmip6_historical_reference_screen_v1",
  "reference_role": "ERA5-Land_reanalysis_reference_not_observational_truth",
  "period": {"start": "1985-01-01", "end": "2014-12-31"},
  "calendar_alignment": "remove_february_29_from_all_series_and_compare_365_day_calendars",
  "variables": ["tasmax", "tasmin", "hurs", "sfcWind", "rsds", "pr"],
  "quantiles": [0.01, 0.05, 0.5, 0.95, 0.99],
  "normalization": "divide_absolute_error_by_reference_q95_minus_q05_with_variable_floor",
  "normalization_floors": {
    "tasmax": 1.0,
    "tasmin": 1.0,
    "hurs": 2.0,
    "sfcWind": 0.25,
    "rsds": 10.0,
    "pr": 1.0
  },
  "categories": {
    "marginal_distribution": {
      "weight": 0.3,
      "metric": "mean_normalized_absolute_error_at_declared_quantiles"
    },
    "seasonal_cycle": {
      "weight": 0.2,
      "metric": "mean_normalized_rmse_of_twelve_monthly_means"
    },
    "multivariate_dependence": {
      "weight": 0.2,
      "metric": "mean_absolute_off_diagonal_spearman_correlation_error"
    },
    "daily_persistence": {
      "weight": 0.15,
      "metric": "mean_absolute_lag_one_autocorrelation_error"
    },
    "annual_extremes_and_compound_events": {
      "weight": 0.15,
      "metric": "mean_normalized_error_of_annual_feature_means",
      "features": [
        "txx",
        "tnx",
        "rx1day",
        "cdd",
        "hot_days",
        "warm_night_days",
        "hot_dry_days",
        "hot_dry_low_wind_days"
      ],
      "thresholds": "site_reference_month_specific_q90_temperature_and_q10_wind; dry_day_pr_below_1_mm"
    }
  },
  "stability": {
    "method": "leave_one_nonoverlapping_five_year_block_out",
    "blocks": 6,
    "report": ["rank_min", "rank_median", "rank_max"]
  },
  "selection_rule": {
    "automatic_exclusion": false,
    "reason": "A reanalysis-only screen cannot establish observational validity or justify eliminating climate-response diversity.",
    "provisional_shortlist": "three_lowest_composite_scores_for_method_development_only",
    "all_models_continue_to_observation_gate": true
  },
  "interpretation_limits": [
    "ERA5-Land is a reanalysis reference and is not observational truth.",
    "NEX-GDDP-CMIP6 is bias adjusted; small historical marginal errors are not independent evidence of model quality.",
    "Daily paired RMSE and correlation are excluded because free-running GCM weather is not expected to match observed day-to-day chronology.",
    "The screen does not assign probabilities to GCMs or SSPs.",
    "Concurrent wet-bulb skill is not scored because the selected NEX product provides daily relative humidity rather than concurrent hourly temperature and humidity."
  ]
}
