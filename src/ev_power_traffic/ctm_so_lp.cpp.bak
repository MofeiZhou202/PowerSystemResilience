// ctm_so_lp.cpp
// ──────────────────────────────────────────────────────────────────────────
// System-Optimal CTM LP (Formulation E)
//
// Minimises total vehicle-hours (proxy for social travel-time cost) subject
// to linearised Cell Transmission Model flow constraints.  The formulation
// decomposes the joint OD-route assignment and CTM cell-flow problem into a
// single LP by parameterising traffic dynamics as linear constraints on the
// per-cell occupancy n_{a,m,k} and inter-cell flow y_{a,m,k}.
//
// Formulation variables (all ≥ 0):
//   n_{a,m,k}   cell occupancy [veh]         a=link, m=cell, k=step
//   y_{a,m,k}   inter-cell flow [veh/step]   m=0 is link entry; M_a is exit
//   h_{d,r,k}   route flow [veh]              demand d, route r, depart k
//
// Objective: Minimize Σ_{a,m,k} n_{a,m,k} · dt   [veh·hr]
//
// Constraints:
//   (1) Cell balance:  n_{a,m,k+1} = n_{a,m,k} + y_{a,m-1,k} - y_{a,m,k}
//   (2) Sending (ff):  y_{a,m,k} ≤ n_{a,m,k} · (v_f / δ) · dt
//   (3) Capacity:      y_{a,m,k} ≤ q̄_a · dt
//   (4) Receiving:     y_{a,m,k} ≤ (n_jam - n_{a,m+1,k}) · (w / δ) · dt
//   (5) Entry flow:    y_{a,-1,k} = Σ_{d,r: link a ∈ r, dep k} h_{d,r,k}
//   (6) OD balance:    Σ_r h_{d,r,k} = D_{d,k}  (demand by departure step)
//
// Returns CTMSOLPResult with SO route flows, cell occupancies, and TSTT.
// ──────────────────────────────────────────────────────────────────────────

#include "evpt_internal.hpp"

#include "hacdcpf/engine/engine.hpp"
#include "hacdcpf/engine/kernel/lp_kernel/dual_simplex.hpp"

namespace hacdcpf::evpt {

CTMSOLPResult solve_ctm_so_lp(
    const EVPowerTrafficProblem& problem,
    const EVPowerTrafficOptions& ev_opts,
    const CTMOptions& ctm_opts)
{
  CTMSOLPResult result;

  const double dt_sim = ev_opts.time_step_hr;
  const int T_sim     = ev_opts.num_steps;
  if (T_sim <= 0 || dt_sim <= kTol) {
    result.infeasible = true;
    result.status = "empty";
    return result;
  }

  // ── CTM discretisation ─────────────────────────────────────────────────
  const double dt_ctm = choose_ctm_dt(problem, ctm_opts, dt_sim);
  const int    R      = std::max(1, static_cast<int>(std::round(dt_sim / dt_ctm)));
  const int    T_ctm  = T_sim * R;

  // ── Index maps ──────────────────────────────────────────────────────────
  std::unordered_map<int, std::size_t> link_pos;
  for (std::size_t i = 0; i < problem.traffic.links.size(); ++i)
    link_pos[problem.traffic.links[i].index] = i;

  const int n_links  = static_cast<int>(problem.traffic.links.size());
  const int n_routes = static_cast<int>(problem.routes.size());

  // ── Build link cell parameters ──────────────────────────────────────────
  // n_cells[li], vf[li], w[li], delt[li], qmax[li], njam_per_cell[li]
  struct LinkCellParams {
    int    M;        // number of cells
    double vf;       // free-flow speed [km/step] = v_f_km_hr * dt_ctm
    double w;        // backward wave speed [km/step]
    double delta;    // cell length [km]
    double qmax;     // capacity [veh/step]
    double njam;     // jam occupancy per cell [veh]
  };
  std::vector<LinkCellParams> lcp(static_cast<std::size_t>(n_links));
  for (int li = 0; li < n_links; ++li) {
    const auto& lnk = problem.traffic.links[static_cast<std::size_t>(li)];
    const int M = std::max(1, ctm_opts.n_cells_per_link);
    const double len_km = std::max(kTol, lnk.length_km);
    const double delta = len_km / static_cast<double>(M);
    const double vf_km_hr = link_free_flow_speed(lnk);
    const double vf_km_step = vf_km_hr * dt_ctm;
    const double qmax_for_bw = lnk.capacity_veh_per_hr > kTol ? lnk.capacity_veh_per_hr : vf_km_hr * 0.1;
    const double w_km_hr = [&]{
      if (lnk.length_km > kTol) {
        const double kj = lnk.jam_vehicles > kTol
            ? lnk.jam_vehicles / lnk.length_km
            : qmax_for_bw / vf_km_hr * 2.0;
        const double kc = qmax_for_bw / vf_km_hr;
        if (kj > kc + kTol) return qmax_for_bw / (kj - kc);
      }
      const double fb = ctm_opts.backward_wave_speed_fallback_km_hr;
      return fb > kTol ? fb : vf_km_hr * 0.25;
    }();
    const double w_km_step = std::max(kTol, w_km_hr) * dt_ctm;
    const double qmax_veh_step = std::max(kTol,
        lnk.capacity_veh_per_hr > kTol ? lnk.capacity_veh_per_hr * dt_ctm
                                       : vf_km_step / delta);
    const double kj = vf_km_step / (delta * w_km_step / delta + vf_km_step / delta);
    const double njam = std::max(1.0, kj * delta);
    lcp[static_cast<std::size_t>(li)] = {M, vf_km_step, w_km_step, delta, qmax_veh_step, njam};
  }

  // ── LP construction ──────────────────────────────────────────────────────
  engine::MIPModel mip;
  engine::LPModel& lp = mip.linear_part;
  lp.sense = engine::Sense::Minimize;

  std::vector<engine::VariableMeta> vars;
  std::vector<double> obj_vec;
  std::vector<Eigen::Triplet<double>> eq_trips, ineq_trips;
  std::vector<double> beq_vec, bineq_vec;

  auto add_var = [&](double lb, double ub, double cost, const std::string& name) -> int {
    const int idx = static_cast<int>(vars.size());
    vars.push_back({engine::VarType::Continuous, lb, ub, name});
    obj_vec.push_back(cost);
    return idx;
  };
  auto add_eq = [&](double rhs) -> int {
    const int row = static_cast<int>(beq_vec.size());
    beq_vec.push_back(rhs);
    return row;
  };
  auto add_ineq = [&](double rhs) -> int {
    const int row = static_cast<int>(bineq_vec.size());
    bineq_vec.push_back(rhs);
    return row;
  };

  // ── Allocate n_{a,m,k} and y_{a,m,k} variables ─────────────────────────
  // n_idx[li][m][k] and y_idx[li][m][k]  (m ∈ [0,M-1], y at m is exit of cell m)
  // Entry to link a at step k: y_{a,-1,k} — represented as y_idx[li][-1][k] = y_entry[li][k]
  using Idx3 = std::vector<std::vector<std::vector<int>>>;
  Idx3 n_idx(static_cast<std::size_t>(n_links));
  Idx3 y_idx(static_cast<std::size_t>(n_links));  // y_idx[li][m][k] = exit of cell m at step k
  std::vector<std::vector<int>> y_entry(static_cast<std::size_t>(n_links));  // entry inflow [li][k]

  for (int li = 0; li < n_links; ++li) {
    const auto& p = lcp[static_cast<std::size_t>(li)];
    n_idx[static_cast<std::size_t>(li)].assign(
        static_cast<std::size_t>(p.M),
        std::vector<int>(static_cast<std::size_t>(T_ctm + 1), -1));
    y_idx[static_cast<std::size_t>(li)].assign(
        static_cast<std::size_t>(p.M),
        std::vector<int>(static_cast<std::size_t>(T_ctm), -1));
    y_entry[static_cast<std::size_t>(li)].assign(
        static_cast<std::size_t>(T_ctm), -1);

    for (int m = 0; m < p.M; ++m) {
      for (int k = 0; k <= T_ctm; ++k) {
        n_idx[static_cast<std::size_t>(li)][static_cast<std::size_t>(m)][static_cast<std::size_t>(k)] =
            add_var(0.0, p.njam,
                    dt_ctm,  // cost = dt_ctm → objective = total veh·steps = veh·hr
                    "n_a" + std::to_string(li) + "_m" + std::to_string(m) + "_k" + std::to_string(k));
      }
      for (int k = 0; k < T_ctm; ++k) {
        y_idx[static_cast<std::size_t>(li)][static_cast<std::size_t>(m)][static_cast<std::size_t>(k)] =
            add_var(0.0, p.qmax,
                    0.0,  // no direct cost on flows
                    "y_a" + std::to_string(li) + "_m" + std::to_string(m) + "_k" + std::to_string(k));
      }
    }
    for (int k = 0; k < T_ctm; ++k) {
      y_entry[static_cast<std::size_t>(li)][static_cast<std::size_t>(k)] =
          add_var(0.0, p.qmax, 0.0,
                  "yent_a" + std::to_string(li) + "_k" + std::to_string(k));
    }
  }

  // ── Route flow variables h_{d,r,k} ─────────────────────────────────────
  // h_idx[demand_pos][route_in_demand][k_dep_ctm]
  std::unordered_map<int, std::unordered_map<int, int>> h_idx;  // demand_idx → route_idx → lp_col
  // OD conservation (eq rows)
  std::unordered_map<int, std::unordered_map<int, int>> od_eq_row;  // demand_idx → k_dep_ctm → eq row

  for (const auto& demand : problem.demands) {
    if (demand.vehicles <= kTol) continue;
    const int k_dep = demand.departure_step * R;
    if (k_dep < 0 || k_dep >= T_ctm) continue;
    // Add OD eq row
    if (!od_eq_row.count(demand.index) || !od_eq_row.at(demand.index).count(k_dep)) {
      const int row = add_eq(demand.vehicles);
      od_eq_row[demand.index][k_dep] = row;
    }
    for (const auto* route : candidate_routes(problem, demand)) {
      if (!route_soc_feasible(*route, demand, problem, link_pos)) continue;
      const int h_var = add_var(0.0, demand.vehicles, 0.0,
          "h_d" + std::to_string(demand.index) + "_r" + std::to_string(route->index));
      h_idx[demand.index][route->index] = h_var;
      eq_trips.emplace_back(od_eq_row.at(demand.index).at(k_dep), h_var, 1.0);
    }
    // Unserved penalty
    if (ev_opts.allow_unserved_travel_demand) {
      const double pen = std::max(0.0, ev_opts.value_of_time_per_hr * static_cast<double>(T_sim));
      const int u_var = add_var(0.0, demand.vehicles, pen,
          "u_d" + std::to_string(demand.index));
      eq_trips.emplace_back(od_eq_row.at(demand.index).at(k_dep), u_var, 1.0);
    }
  }

  const int n_vars = static_cast<int>(vars.size());

  // ── CTM flow constraints ─────────────────────────────────────────────────
  for (int li = 0; li < n_links; ++li) {
    const auto& p = lcp[static_cast<std::size_t>(li)];
    const double vf_rate = p.vf / p.delta;  // cells/step capacity factor
    const double w_rate  = p.w  / p.delta;

    for (int k = 0; k < T_ctm; ++k) {
      for (int m = 0; m < p.M; ++m) {
        const int n_km  = n_idx[static_cast<std::size_t>(li)][static_cast<std::size_t>(m)][static_cast<std::size_t>(k)];
        const int n_kp1 = n_idx[static_cast<std::size_t>(li)][static_cast<std::size_t>(m)][static_cast<std::size_t>(k + 1)];
        const int y_m   = y_idx[static_cast<std::size_t>(li)][static_cast<std::size_t>(m)][static_cast<std::size_t>(k)];  // exit of m
        const int y_in  = (m == 0)
            ? y_entry[static_cast<std::size_t>(li)][static_cast<std::size_t>(k)]
            : y_idx[static_cast<std::size_t>(li)][static_cast<std::size_t>(m - 1)][static_cast<std::size_t>(k)];  // exit of m-1 = entry to m

        // (1) Cell balance: n_{k+1} = n_k + y_in - y_m
        const int bal = add_eq(0.0);
        eq_trips.emplace_back(bal, n_kp1,  1.0);
        eq_trips.emplace_back(bal, n_km,  -1.0);
        eq_trips.emplace_back(bal, y_in,  -1.0);
        eq_trips.emplace_back(bal, y_m,    1.0);

        // (2) Sending (free-flow): y_m ≤ n_k * vf_rate
        {
          const int row = add_ineq(0.0);
          ineq_trips.emplace_back(row, y_m,   1.0);
          ineq_trips.emplace_back(row, n_km, -vf_rate);
        }
        // (3) Sending (capacity): y_m ≤ qmax
        // Upper bound on y_m variable handles this.

        // (4) Receiving: y_m ≤ (n_jam - n_{m+1,k}) * w_rate
        if (m + 1 < p.M) {
          const int n_next = n_idx[static_cast<std::size_t>(li)][static_cast<std::size_t>(m + 1)][static_cast<std::size_t>(k)];
          const int row = add_ineq(p.njam * w_rate);
          ineq_trips.emplace_back(row, y_m,     1.0);
          ineq_trips.emplace_back(row, n_next,  w_rate);
        }
        // Last cell: exit to next link — no receiving constraint from this link's side
      }
    }
  }

  // ── Link entry = sum of route flows entering at that link ───────────────
  // y_entry[li][k] = Σ_{d,r: first link = li, dep_step = k} h_{d,r,k}
  // and also sum of route flows passing through internal links at step k
  // (departure step determines when flow enters first link; for internal links
  //  the routing is fixed by route structure but LP doesn't track per-route cells)
  // Simplified: only constrain entry flows from origin demands; internal
  // inter-link flow balance is enforced through the cell balance equalities
  // by summing y_exit of upstream link = y_entry of downstream link at node.
  //
  // For each link, entry flow must equal sum of h-flows for routes whose first
  // link is this link.
  std::unordered_map<int, std::unordered_map<int, int>> entry_eq_rows;
  for (const auto& demand : problem.demands) {
    if (demand.vehicles <= kTol) continue;
    const int k_dep = demand.departure_step * R;
    if (k_dep < 0 || k_dep >= T_ctm) continue;
    for (const auto* route : candidate_routes(problem, demand)) {
      if (!h_idx.count(demand.index) || !h_idx.at(demand.index).count(route->index)) continue;
      if (route->link_indices.empty()) continue;
      const int h_var = h_idx.at(demand.index).at(route->index);
      // Entry link
      const int entry_link_idx = route->link_indices.front();
      auto it = link_pos.find(entry_link_idx);
      if (it == link_pos.end()) continue;
      const int li = static_cast<int>(it->second);
      // y_entry[li][k_dep] += h_var
      // We add an inequality: y_entry ≥ Σ h, and y_entry ≤ Σ h (equality via two ineqs)
      // Actually, build an equality: y_entry[li][k] = Σ h (for that entry link & k)
      // Use a dedicated eq row per (li, k_dep)
      // (accumulate via eq_trips — multiple routes contribute to same row)
      // We create the row lazily:
      if (!entry_eq_rows.count(li) || !entry_eq_rows.at(li).count(k_dep)) {
        const int row = add_eq(0.0);
        entry_eq_rows[li][k_dep] = row;
        // Add y_entry variable to this row with coefficient -1
        eq_trips.emplace_back(row, y_entry[static_cast<std::size_t>(li)][static_cast<std::size_t>(k_dep)], -1.0);
      }
      eq_trips.emplace_back(entry_eq_rows.at(li).at(k_dep), h_var, 1.0);
    }
  }

  // ── Assemble LP ────────────────────────────────────────────────────────
  lp.c     = Eigen::VectorXd::Map(obj_vec.data(), n_vars);
  lp.vars  = std::move(vars);

  if (!beq_vec.empty()) {
    lp.Aeq.resize(static_cast<int>(beq_vec.size()), n_vars);
    lp.Aeq.setFromTriplets(eq_trips.begin(), eq_trips.end());
    lp.Aeq.makeCompressed();
    lp.beq = Eigen::VectorXd::Map(beq_vec.data(), static_cast<Eigen::Index>(beq_vec.size()));
  }

  if (!bineq_vec.empty()) {
    lp.A.resize(static_cast<int>(bineq_vec.size()), n_vars);
    lp.A.setFromTriplets(ineq_trips.begin(), ineq_trips.end());
    lp.A.makeCompressed();
    lp.b = Eigen::VectorXd::Map(bineq_vec.data(), static_cast<Eigen::Index>(bineq_vec.size()));
  }

  // ── Solve ─────────────────────────────────────────────────────────────
  engine::SimplexOptions simp_opt;
  simp_opt.max_iter = 100000;
  simp_opt.feasibility_tol = 1e-8;
  simp_opt.optimality_tol  = 1e-8;
  simp_opt.verbose = false;
  auto lp_result = engine::solve_lp_with_basis(lp, simp_opt, nullptr);

  result.solved     = lp_result.result.stats.success;
  result.infeasible = !result.solved;
  result.status     = lp_result.result.stats.status;
  result.objective  = result.solved ? lp_result.result.stats.objective : 0.0;

  if (!result.solved) return result;

  const auto& x = lp_result.result.x;

  // ── Extract route flows ─────────────────────────────────────────────
  for (const auto& demand : problem.demands) {
    if (demand.vehicles <= kTol) continue;
    if (!h_idx.count(demand.index)) continue;
    for (const auto& [ridx, hvar] : h_idx.at(demand.index)) {
      if (hvar >= 0 && hvar < static_cast<int>(x.size()))
        result.flow_by_demand_route[demand.index][ridx] = x[hvar];
    }
  }

  // ── Compute SO TSTT ────────────────────────────────────────────────
  // TSTT = Σ_{a,m,k} n_{a,m,k} * dt_ctm
  double tstt = 0.0;
  for (int li = 0; li < n_links; ++li) {
    const auto& p = lcp[static_cast<std::size_t>(li)];
    for (int m = 0; m < p.M; ++m)
      for (int k = 0; k < T_ctm; ++k) {
        const int idx = n_idx[static_cast<std::size_t>(li)][static_cast<std::size_t>(m)][static_cast<std::size_t>(k)];
        if (idx >= 0 && idx < static_cast<int>(x.size()))
          tstt += x[idx] * dt_ctm;
      }
  }
  result.so_tstt_hr = tstt;

  return result;
}

}  // namespace hacdcpf::evpt
